#!/usr/bin/python3
import os
import sys

# Paket kurulumunda modül /usr/share/bloodyt60 altındadır.
_share = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "share", "bloodyt60")
if os.path.isdir(os.path.join(_share, "bloodyt60")):
    sys.path.insert(0, _share)

from bloodyt60.__main__ import main  # noqa: E402

sys.exit(main())
